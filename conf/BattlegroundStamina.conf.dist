# Battleground stamina assistance
#
# Aura spell 901002 is installed by data/sql/db-world/2026_09_16_00_battleground_stamina_spell.sql.
# Before production deployment, verify that the ID is free in the live world
# database and selected client Spell.dbc. Effect 0 must be:
#   SPELL_EFFECT_APPLY_AURA / SPELL_AURA_MOD_STAT / STAT_STAMINA
# It must be a non-passive generic spell targeting TARGET_UNIT_CASTER, with
# EffectDieSides 0 or 1 and no level or combo-point amount scaling.
# The spell should also be non-dispellable, non-cancellable, death-persistent,
# and marked SPELL_ATTR0_CU_AURA_CANNOT_BE_SAVED in spell_custom_attr.

Apocalipse.BattlegroundStamina.Enable = 1
# Locks non-combat-swappable equipment for human players in battlegrounds.
# Native weapon, offhand, projectile and relic swaps remain available.
# Playerbot sessions are exempt from this lock.
Apocalipse.BattlegroundStamina.LockGear = 1
Apocalipse.BattlegroundStamina.AuraSpellId = 901002

# Percentage of the gap between unbuffed baseline health and the configured
# threshold converted into bonus stamina. Values are clamped to 0-99 so that
# better gear always increases assisted health. At 50%, gaining 100 baseline
# health still gains 50 assisted health while the assistance falls by 50.
Apocalipse.BattlegroundStamina.GapCoveragePct = 50.0

# Safety cap for malformed or experimental threshold values.
Apocalipse.BattlegroundStamina.MaxBonusStamina = 5000

# Initial tuning values. A threshold of 0 disables assistance for that
# class/bracket. Death knights are disabled below their normal starting range.

